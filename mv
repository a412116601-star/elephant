<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>书影时光 | 公开共享版</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Vue 3 -->
  <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
  <!-- Supabase SDK -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <!-- FontAwesome 图标 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen font-sans">

<div id="app" class="max-w-6xl mx-auto px-4 py-8">
  
  <!-- 页头与统计数据 -->
  <header class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-8 border-b border-zinc-800">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight flex items-center gap-3 text-amber-400">
        <span>📖🎬</span>
        <span>书影时光</span>
      </h1>
      <p class="text-sm text-zinc-400 mt-1">云端实时同步 · 所有人均可访问观看</p>
    </div>

    <!-- 数据看板 -->
    <div class="flex items-center gap-4 bg-zinc-900/80 p-3 rounded-2xl border border-zinc-800 text-xs">
      <div class="px-3 border-r border-zinc-800 text-center">
        <div class="text-zinc-400">读过图书</div>
        <div class="text-lg font-bold text-emerald-400 mt-0.5">{{ bookCount }} 本</div>
      </div>
      <div class="px-3 border-r border-zinc-800 text-center">
        <div class="text-zinc-400">看过电影</div>
        <div class="text-lg font-bold text-amber-400 mt-0.5">{{ movieCount }} 部</div>
      </div>
      <div class="px-3 text-center">
        <div class="text-zinc-400">云端状态</div>
        <div class="text-xs font-bold mt-1" :class="isConnected ? 'text-emerald-400' : 'text-amber-500'">
          {{ isConnected ? '● 已联网' : '○ 离线模式' }}
        </div>
      </div>
    </div>
  </header>

  <!-- 操作与筛选栏 -->
  <div class="my-6 flex flex-col md:flex-row gap-4 items-center justify-between">
    
    <!-- 分类切换 -->
    <div class="flex p-1 bg-zinc-900 rounded-xl border border-zinc-800 w-full md:w-auto">
      <button 
        v-for="type in typeFilters" 
        :key="type.value"
        @click="currentType = type.value"
        :class="['px-4 py-2 rounded-lg text-xs font-medium transition flex-1 md:flex-initial flex items-center justify-center gap-2',
                 currentType === type.value ? 'bg-amber-500 text-zinc-950 font-bold' : 'text-zinc-400 hover:text-zinc-200']"
      >
        <span>{{ type.icon }}</span>
        <span>{{ type.label }}</span>
      </button>
    </div>

    <!-- 搜索与添加 -->
    <div class="flex items-center gap-3 w-full md:w-auto">
      <div class="relative flex-1 md:w-48">
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500 text-xs"></i>
        <input 
          v-model="searchQuery" 
          type="text" 
          placeholder="搜索书名、影名或作者..."
          class="w-full bg-zinc-900 text-xs pl-8 pr-3 py-2.5 rounded-xl border border-zinc-800 focus:outline-none focus:border-amber-500 text-zinc-200"
        />
      </div>
      <button @click="openModal()" class="px-4 py-2.5 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-bold rounded-xl text-xs transition flex items-center gap-2 whitespace-nowrap shadow-lg shadow-amber-500/10">
        <i class="fa-solid fa-plus"></i> 添加记录
      </button>
    </div>
  </div>

  <!-- 加载状态 -->
  <div v-if="loading" class="text-center py-20 text-zinc-500">
    <i class="fa-solid fa-spinner fa-spin text-2xl mb-2 text-amber-500"></i>
    <p class="text-xs">正在拉取云端数据...</p>
  </div>

  <!-- 网格展示区 -->
  <main v-else-if="filteredItems.length > 0" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5">
    <div 
      v-for="item in filteredItems" 
      :key="item.id"
      class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl overflow-hidden hover:border-amber-500/40 transition duration-300 flex flex-col group relative"
    >
      <div class="relative aspect-[2/3] overflow-hidden bg-zinc-950">
        <img :src="item.cover" :alt="item.title" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
        <span class="absolute top-2 left-2 px-2 py-0.5 rounded-md text-[10px] font-bold backdrop-blur-md bg-black/60 border border-white/10 text-zinc-300">
          {{ item.type === 'book' ? '📚 图书' : '🎬 电影' }}
        </span>
        <span class="absolute top-2 right-2 px-2 py-0.5 rounded-md text-[10px] font-bold backdrop-blur-md bg-black/60 border border-amber-400/30 text-amber-400">
          ★ {{ item.rating }}
        </span>

        <!-- 编辑与删除按钮 -->
        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition duration-300 flex items-center justify-center gap-3">
          <button @click="openModal(item)" class="w-8 h-8 rounded-full bg-amber-500 text-zinc-950 flex items-center justify-center hover:scale-110 transition">
            <i class="fa-solid fa-pen text-xs"></i>
          </button>
          <button @click="deleteItem(item.id)" class="w-8 h-8 rounded-full bg-rose-600/80 text-white flex items-center justify-center hover:scale-110 transition">
            <i class="fa-solid fa-trash text-xs"></i>
          </button>
        </div>
      </div>

      <div class="p-3 flex-1 flex flex-col justify-between">
        <div>
          <h3 class="font-bold text-sm text-zinc-100 line-clamp-1 group-hover:text-amber-400 transition">{{ item.title }}</h3>
          <p class="text-[11px] text-zinc-400 mt-0.5 line-clamp-1">{{ item.creator || '未知作者/导演' }}</p>
        </div>
        <div class="mt-3 pt-2 border-t border-zinc-800/60 flex items-center justify-between text-[11px]">
          <span class="text-amber-400 font-medium">{{ getStatusText(item) }}</span>
          <span class="text-zinc-500">{{ item.date }}</span>
        </div>
      </div>
    </div>
  </main>

  <!-- 空状态 -->
  <div v-else class="text-center py-20 text-zinc-600 border border-dashed border-zinc-800 rounded-2xl">
    <i class="fa-solid fa-folder-open text-4xl mb-3"></i>
    <p class="text-sm">暂无记录，快点击右上角添加吧！</p>
  </div>

  <!-- Modal 弹窗 -->
  <div v-if="showModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4" @click.self="showModal = false">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl relative text-xs">
      <h3 class="text-base font-bold text-zinc-100 mb-4">{{ form.id ? '✏️ 编辑记录' : '✨ 新增书影' }}</h3>
      <form @submit.prevent="saveItem" class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <label class="flex items-center justify-center gap-2 p-2.5 rounded-xl border cursor-pointer" :class="form.type === 'book' ? 'bg-amber-500/10 border-amber-500 text-amber-400' : 'bg-zinc-950 border-zinc-800 text-zinc-400'">
            <input type="radio" v-model="form.type" value="book" class="hidden">
            <span>📚 图书</span>
          </label>
          <label class="flex items-center justify-center gap-2 p-2.5 rounded-xl border cursor-pointer" :class="form.type === 'movie' ? 'bg-amber-500/10 border-amber-500 text-amber-400' : 'bg-zinc-950 border-zinc-800 text-zinc-400'">
            <input type="radio" v-model="form.type" value="movie" class="hidden">
            <span>🎬 电影</span>
          </label>
        </div>

        <div>
          <label class="block text-zinc-400 mb-1">名称 *</label>
          <input v-model="form.title" required type="text" placeholder="书名 / 电影名" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-200 focus:outline-none focus:border-amber-500" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-zinc-400 mb-1">作者 / 导演</label>
            <input v-model="form.creator" type="text" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-200 focus:outline-none focus:border-amber-500" />
          </div>
          <div>
            <label class="block text-zinc-400 mb-1">评分</label>
            <input v-model.number="form.rating" type="number" step="0.1" min="0" max="10" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-200 focus:outline-none focus:border-amber-500" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-zinc-400 mb-1">状态</label>
            <select v-model="form.status" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-200 focus:outline-none focus:border-amber-500">
              <option value="want">{{ form.type === 'book' ? '🔖 想读' : '🔖 想看' }}</option>
              <option value="doing">{{ form.type === 'book' ? '📖 在读' : '🍿 在看' }}</option>
              <option value="done">{{ form.type === 'book' ? '✅ 已读' : '✅ 已看' }}</option>
            </select>
          </div>
          <div>
            <label class="block text-zinc-400 mb-1">日期</label>
            <input v-model="form.date" type="date" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-200 focus:outline-none focus:border-amber-500" />
          </div>
        </div>

        <div>
          <label class="block text-zinc-400 mb-1">封面图片 URL</label>
          <input v-model="form.cover" type="url" placeholder="https://..." class="w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-200 focus:outline-none focus:border-amber-500" />
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" @click="showModal = false" class="px-4 py-2 bg-zinc-800 rounded-xl text-zinc-300">取消</button>
          <button type="submit" class="px-5 py-2 bg-amber-500 font-bold text-zinc-950 rounded-xl">同步保存至云端</button>
        </div>
      </form>
    </div>
  </div>

</div>

<script>
// ⚠️ 填入你的 Supabase 密钥
const SUPABASE_URL = 'https://fqxfxdwpwvehdmbkowhq.supabase.co/rest/v1/';
const SUPABASE_ANON_KEY = 'sb_publishable_yZWjGZcwGbYh4CSwA8bN0Q_vcDrr_y9';

const isConfigured = SUPABASE_URL !== 'https://YOUR_SUPABASE_PROJECT_ID.supabase.co';
const db = isConfigured ? supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY) : null;

const { createApp } = Vue;

createApp({
  data() {
    return {
      showModal: false,
      loading: true,
      isConnected: isConfigured,
      currentType: 'all',
      searchQuery: '',
      typeFilters: [
        { label: '全部', value: 'all', icon: '✨' },
        { label: '图书', value: 'book', icon: '📚' },
        { label: '电影', value: 'movie', icon: '🎬' }
      ],
      form: { id: null, type: 'book', title: '', creator: '', rating: 9.0, status: 'done', date: '', cover: '' },
      items: []
    }
  },
  computed: {
    bookCount() { return this.items.filter(i => i.type === 'book' && i.status === 'done').length; },
    movieCount() { return this.items.filter(i => i.type === 'movie' && i.status === 'done').length; },
    filteredItems() {
      return this.items.filter(item => {
        const matchType = this.currentType === 'all' || item.type === this.currentType;
        const matchSearch = item.title.toLowerCase().includes(this.searchQuery.toLowerCase()) ||
                            (item.creator && item.creator.toLowerCase().includes(this.searchQuery.toLowerCase()));
        return matchType && matchSearch;
      });
    }
  },
  async mounted() {
    await this.fetchItems();
  },
  methods: {
    async fetchItems() {
      this.loading = true;
      if (db) {
        const { data, error } = await db.from('media_items').select('*').order('id', { ascending: false });
        if (!error && data) this.items = data;
      } else {
        const local = localStorage.getItem('media_shelf_items');
        this.items = local ? JSON.parse(local) : [];
      }
      this.loading = false;
    },
    async saveItem() {
      if (!this.form.cover) {
        this.form.cover = this.form.type === 'book' 
          ? 'https://images.unsplash.com/photo-1543002588-bfa74002ed7e?w=400&q=80'
          : 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=400&q=80';
      }

      const itemData = {
        id: this.form.id || Date.now(),
        type: this.form.type,
        title: this.form.title,
        creator: this.form.creator,
        rating: this.form.rating,
        status: this.form.status,
        date: this.form.date,
        cover: this.form.cover
      };

      if (db) {
        await db.from('media_items').upsert(itemData);
        await this.fetchItems();
      } else {
        const idx = this.items.findIndex(i => i.id === itemData.id);
        if (idx !== -1) this.items[idx] = itemData;
        else this.items.unshift(itemData);
        localStorage.setItem('media_shelf_items', JSON.stringify(this.items));
      }
      this.showModal = false;
    },
    async deleteItem(id) {
      if (confirm('确定要删除吗？所有人刷新后都将无法看到此条目。')) {
        if (db) {
          await db.from('media_items').delete().eq('id', id);
          await this.fetchItems();
        } else {
          this.items = this.items.filter(i => i.id !== id);
          localStorage.setItem('media_shelf_items', JSON.stringify(this.items));
        }
      }
    },
    getStatusText(item) {
      const map = { want: '🔖 想看/想读', doing: '📖 在看/在读', done: '✅ 已看/已读' };
      return map[item.status];
    },
    openModal(item = null) {
      this.form = item ? { ...item } : {
        id: null, type: 'book', title: '', creator: '', rating: 9.0, status: 'done',
        date: new Date().toISOString().substring(0, 10), cover: ''
      };
      this.showModal = true;
    }
  }
}).mount('#app');
</script>
</body>
</html>
